# Cloudflare Workers Static Assets header rules. Copied verbatim into out/ by
# `next build`, then read by Wrangler at deploy time (it is never served).
#
# Next writes route-handler and metadata-route output as extension-less files
# (out/api/github, out/opengraph-image), so Wrangler cannot infer a MIME type
# from the filename. Without these rules the OG image is served as
# application/octet-stream and social-card crawlers reject it.

/opengraph-image
  Content-Type: image/png

# Listed one by one, not as /api/*, so a miss under /api/ still serves the
# 404 page as HTML.
/api/github
  Content-Type: application/json; charset=utf-8

/api/leetcode
  Content-Type: application/json; charset=utf-8

/api/codeforces
  Content-Type: application/json; charset=utf-8

/api/verifications
  Content-Type: application/json; charset=utf-8

# Content-hashed build output: the filename changes whenever the bytes do, so a
# one-year immutable cache is safe and a revalidation is pure waste. Without
# this rule Wrangler serves these `max-age=0, must-revalidate` and every repeat
# visitor re-checks every chunk (confirmed against the live deployment).
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Unlisted pages. The meta robots tag in each page covers crawlers that render
# HTML; this header covers the ones that only read headers, and any direct hit
# on the .txt payload Next writes beside each route.
/vault
  X-Robots-Tag: noindex, nofollow

/views
  X-Robots-Tag: noindex, nofollow

# Build time only. In production this is a Cloudflare Workers Builds
# "build variable", not a Worker secret — the stats are baked into the static
# export at build time.
GITHUB_TOKEN=

# Upstash Redis (visitor counter) — create a free DB at upstash.com, then copy
# its REST URL/token here. Read at runtime by worker.ts; in production these are
# Cloudflare Worker *secrets* (`npx wrangler secret put UPSTASH_REDIS_REST_URL`).
# If your Upstash database came from the Vercel Marketplace integration, the
# same two values may be sitting in your dashboard as STORAGE_KV_REST_API_URL
# and STORAGE_KV_REST_API_TOKEN.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

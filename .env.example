# Build time only. In production this is a Cloudflare Workers Builds
# "build variable", not a Worker secret — the stats are baked into the static
# export at build time. Without it GitHub answers 403 and the GitHub card
# renders its "Disconnected" fallback, which is what the live site does today.
GITHUB_TOKEN=

# Cloudflare Turnstile — the bot gate on the contact and newsletter forms.
# The site key is public and is baked into the export at build time; the secret
# key is a Worker secret and is only ever read inside worker.ts.
# Create both at dash.cloudflare.com -> Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend (contact form delivery). Free tier: 3,000/month, 100/day. Without a
# verified domain Resend will only send TO your own signup address — which is
# exactly what a contact form does, so this works with no domain.
# Worker secrets, both of them.
RESEND_API_KEY=
CONTACT_TO_EMAIL=

# Optional social-proof embed in the footer. Leave empty and the block is not
# rendered at all.
NEXT_PUBLIC_PEERLIST_URL=

# Upstash Redis (visitor counter). Read at runtime by worker.ts; in production
# these are Cloudflare Worker *secrets*
# (`npx wrangler secret put UPSTASH_REDIS_REST_URL`).
#
# NOTE: these are on the way out. The counter is moving to Cloudflare KV so the
# site has one storage vendor instead of two — that swap needs the KV namespace
# id, and until it lands the counter still reads these. They have never been set
# in production, which is why the live badge renders nothing.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

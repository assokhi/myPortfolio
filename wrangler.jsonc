{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "myportfolio",
  "compatibility_date": "2026-09-07",
  // Assets-only Worker: no main, no script, no bindings. Every request is a
  // file in out/ and never counts as a Worker invocation.
  "assets": {
    "directory": "./out",
    // out/404.html, generated by the export.
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
